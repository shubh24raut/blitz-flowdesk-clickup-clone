# Copy to .env.local and fill in real values. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — Neon PostgreSQL (pooled connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/flowdesk?sslmode=require

# Auth — Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage — Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Email — Resend
RESEND_API_KEY=
EMAIL_FROM="FlowDesk <notifications@example.com>"

# Push — Firebase Cloud Messaging (web client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Push — Firebase Admin (server)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
